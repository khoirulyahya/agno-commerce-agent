# ===============================================
# RAPSPOINT AGNO AI AGENT CONFIGURATION
# ===============================================

# Provider Mode: 'openrouter' | 'ollama' | 'gemini'
AI_PROVIDER=openrouter

# 1. OpenRouter Configuration (Cloud - Recommended for Production)
# Dapatkan API key di https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=google/gemini-2.5-flash

# 2. Ollama Configuration (Local Offline - Zero Token Cost)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# 3. Google Gemini Direct (Alternative)
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.0-flash

# Server Port
PORT=8000
